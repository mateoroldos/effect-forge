{
  "name": "effect-forge",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "check": "bun run format:check && bun run lint && bun run check-types",
    "check-types": "turbo check-types",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --no-error-on-unmatched-pattern .",
    "lint:fix": "oxlint --fix --no-error-on-unmatched-pattern .",
    "prepare": "./scripts/prepare-effect.sh && effect-tsgo patch --oxlint"
  },
  "devDependencies": {
    "@effect/tsgo": "0.36.5",
    "oxfmt": "0.64.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "turbo": "2.10.11",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.0"
}
