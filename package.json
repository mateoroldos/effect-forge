{
  "name": "effect-forge",
  "private": true,
  "workspaces": [
    "adapters/*",
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "auth:schema:check": "bun scripts/check-auth-schema.ts",
    "auth:schema:generate": "bun scripts/check-auth-schema.ts --write",
    "build": "turbo build",
    "bump-ui": "bunx shadcn-svelte@latest add --overwrite --yes -c packages/ui $(ls packages/ui/src/ui) && bun run format",
    "check": "bun run format:check && bun run lint && bun run check:architecture && bun run auth:schema:check && bun run db:check && bun run knip && bun run check-types && bun run test",
    "check:architecture": "bun scripts/check-architecture.ts",
    "check-types": "tsc --noEmit && turbo check-types",
    "db:check": "bun scripts/check-migrations.ts",
    "db:generate": "bun run --cwd adapters/database-postgres db:generate",
    "dev": "alchemy dev",
    "dev:site": "alchemy dev alchemy.site.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "prepare": "./scripts/prepare-effect.sh && effect-tsgo patch --oxlint",
    "test": "turbo test && vitest run infra",
    "test:e2e": "bun run --cwd apps/web test:e2e"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "alchemy": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.2",
    "@effect/tsgo": "0.36.5",
    "@oxlint/plugins": "1.78.0",
    "auth": "catalog:",
    "knip": "6.33.0",
    "oxfmt": "0.64.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "turbo": "2.10.11",
    "typescript": "7.0.2",
    "vitest": "catalog:"
  },
  "packageManager": "bun@1.4.0",
  "catalog": {
    "@better-auth/drizzle-adapter": "1.7.4",
    "@effect/platform-bun": "4.0.0-rc.112",
    "@effect/platform-node": "4.0.0-rc.112",
    "@effect/sql-pg": "4.0.0-rc.112",
    "@effect/sql-pglite": "4.0.0-rc.112",
    "@effect/vitest": "4.0.0-rc.112",
    "@electric-sql/pglite": "0.5.7",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.3.14",
    "@types/pg": "8.20.0",
    "alchemy": "2.0.0-beta.77",
    "auth": "1.7.4",
    "better-auth": "1.7.4",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "effect": "4.0.0-rc.112",
    "pg": "8.23.0",
    "svelte": "5.57.0",
    "tailwindcss": "4.3.3",
    "vitest": "4.1.11"
  },
  "patchedDependencies": {
    "@alchemy.run/cloudflare-runtime@2.0.0-beta.77": "patches/@alchemy.run%2Fcloudflare-runtime@2.0.0-beta.77.patch",
    "@alchemy.run/frontend-frameworks@2.0.0-beta.77": "patches/@alchemy.run%2Ffrontend-frameworks@2.0.0-beta.77.patch"
  }
}
