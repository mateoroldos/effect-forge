{
  "name": "effect-forge",
  "private": true,
  "workspaces": [
    "adapters/*",
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "bump-ui": "bunx shadcn@latest add --overwrite -c packages/design-system $(ls packages/design-system/src/ui | sed 's/\\.tsx$//') && bun run format",
    "check": "bun run format:check && bun run lint && bun run check:architecture && bun run check-types && bun run test",
    "check:architecture": "bun scripts/check-architecture.ts",
    "check-types": "tsc --noEmit && turbo check-types",
    "db:generate": "bun run --cwd packages/database db:generate",
    "dev": "alchemy dev",
    "dev:site": "alchemy dev alchemy.site.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "prepare": "./scripts/prepare-effect.sh && effect-tsgo patch --oxlint",
    "test": "turbo test"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "alchemy": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/tsgo": "0.36.5",
    "oxfmt": "0.64.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "turbo": "2.10.11",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.0",
  "catalog": {
    "@effect/platform-bun": "4.0.0-rc.111",
    "@effect/platform-node": "4.0.0-rc.111",
    "@effect/sql-pg": "4.0.0-rc.111",
    "@effect/sql-pglite": "4.0.0-rc.111",
    "@effect/vitest": "4.0.0-rc.111",
    "@electric-sql/pglite": "0.5.7",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.3.14",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "alchemy": "2.0.0-beta.74",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "effect": "4.0.0-rc.111",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3",
    "vitest": "4.1.11"
  }
}
