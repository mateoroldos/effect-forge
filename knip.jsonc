{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Modules re-export themselves (`export * as X from "./x.ts"`) to publish a
  // namespace. Knip cannot follow member access through that cycle, so every
  // export in those files reads as unused.
  "exclude": ["exports", "types"],
  "workspaces": {
    ".": {
      "entry": ["alchemy.run.ts", "alchemy.site.ts", "infra/*.ts", "stacks/*.ts", "scripts/*.ts"],
      "ignoreBinaries": ["maple"],
    },
    "apps/site": {
      // figlet's types are used only from .astro files, which knip cannot read.
      "ignoreDependencies": ["@types/figlet"],
    },
    "apps/web": {
      // SvelteKit discovers the explicit environment contract by convention.
      "entry": ["src/env.ts", "src/lib/server/application.ts"],
      // svelte-check loads TypeScript 7 through the `--tsgo` flag, which does not
      // appear in an import.
      "ignoreDependencies": ["@typescript/native"],
    },
    "packages/ui": {
      // svelte-check refuses to start unless a TypeScript 6 is resolvable, so it is
      // pinned as an API shim. `--tsgo` and `check-types` both run the repository's
      // TypeScript 7 through this alias, which knip cannot see across the shell path.
      "ignoreDependencies": ["@typescript/native"],
    },
  },
}
