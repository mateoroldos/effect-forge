{
  "name": "@effect-forge/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./cn": "./src/cn/cn.ts",
    "./cn.js": "./src/cn/cn.ts",
    "./theme.css": "./src/theme.css",
    "./svelte/*": "./src/svelte/*/index.ts",
    "./svelte/*/index.js": "./src/svelte/*/index.ts",
    "./ui/*": "./src/ui/*.tsx"
  },
  "scripts": {
    "check-types": "./node_modules/@typescript/native/bin/tsc --noEmit && svelte-check --tsgo --tsconfig ./tsconfig.svelte.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@internationalized/date": "3.12.4",
    "@lucide/svelte": "1.40.0",
    "bits-ui": "2.19.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "mode-watcher": "1.1.0",
    "radix-ui": "1.6.7",
    "sonner": "^2.0.8",
    "svelte-sonner": "1.2.1",
    "tailwind-merge": "3.6.0",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@typescript/native": "npm:typescript@7.0.2",
    "react": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "svelte": ">=5"
  }
}
