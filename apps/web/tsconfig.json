{
  "extends": ["../../tsconfig.base.json", "$app/tsconfig"],
  "compilerOptions": {
    // Vite emits, never tsc, so a `.ts` specifier needs no rewriting — and rewriting is
    // what the repository default would refuse to do across the `#lib/*` subpath.
    "rewriteRelativeImportExtensions": false,
    "sourceMap": true
  },
  "include": ["src", "vite.config.ts", "worker.ts"]
}
