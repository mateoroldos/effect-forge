---
import Section from "../components/Section.astro";
import ExampleStack from "../components/ExampleStack.astro";
import InstallCommand from "../components/InstallCommand.svelte";
import { site } from "../site.ts";
---

<Section title="The principles, in a working app.">
  <p class="text-muted-foreground text-pretty">
    The template includes a small SaaS app with accounts, organizations, and shared todos
    to show these principles in practice. Build on it, adapt it, or discard the example
    and keep the engineering foundation for your own product.
  </p>
  <ExampleStack />
  <div class="mt-2 flex flex-col gap-3 border-t pt-6">
    <h3 class="font-serif text-xl">Copy the full template.</h3>
    <p class="text-muted-foreground text-pretty">
      I recommend starting with the agent prompt to choose what fits your product.
      If you want the full stack, copy the template directly and follow the README to set it up.
    </p>
    <InstallCommand client:load command={site.install} />
  </div>
</Section>
