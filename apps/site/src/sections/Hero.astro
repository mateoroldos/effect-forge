---
import StartWithAgent from "../components/StartWithAgent.svelte";
import { site } from "../site.ts";
---

<section class="flex flex-col items-center gap-8 py-4 sm:py-8">
  <div class="flex flex-col items-center gap-7">
    <h1 class="font-serif text-5xl tracking-tight text-center leading-14 text-balance">
      A TypeScript foundation for <span class="text-primary">humans and agents.</span>
    </h1>
    <p class="max-w-lg text-center text-base text-pretty text-muted-foreground">
      Built with Effect, strong types, clear boundaries, and shared engineering standards.
    </p>
  </div>
  <StartWithAgent id="start-with-agent" client:load prompt={site.starterPrompt} repository={site.repository} />
</section>
