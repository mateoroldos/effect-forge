---
import Section from "../components/Section.astro";
import { site } from "../site.ts";

const principles = [
  {
    title: "Agent instructions",
    icon: `<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" /><path d="M14 3v5h5M9 13h6M9 17h4" />`,
    description: "AGENTS.md and task guides keep conventions beside the code. Working examples show how to apply them.",
  },
  {
    title: "Type-driven development",
    icon: `<path d="m8 8-4 4 4 4m8-8 4 4-4 4m-3-10-2 20" />`,
    description: "Schemas validate input. Types make valid states, service dependencies, and expected failures explicit.",
  },
  {
    title: "One check command",
    icon: `<path d="m9 12 2 2 4-4" /><rect x="3" y="3" width="18" height="18" rx="2" />`,
    description: "bun run check covers formatting, lint, types, tests, architecture, migrations, and dead code.",
  },
  {
    title: "Clear boundaries",
    icon: `<rect x="3" y="3" width="18" height="18" rx="2" /><path d="M9 3v18M9 12h12" />`,
    description: "Application logic stays separate from frameworks and providers. Import checks enforce the boundaries.",
  },
  {
    title: "Testable services",
    icon: `<path d="m12 3-9 5 9 5 9-5-9-5ZM3 12l9 5 9-5M3 16l9 5 9-5" />`,
    description: "Compose services with Effect Layers. Substitute dependencies to test behavior through public interfaces.",
  },
  {
    title: "Runtime foundations",
    icon: `<path d="M3 12h4l3-8 4 16 3-8h4" />`,
    description: "Observability and infrastructure are wired in, with separate development and preview environments.",
  },
];
---

<Section title="Built on strong engineering principles.">
  <div class="flex flex-col gap-3">
    <p class="text-muted-foreground text-pretty">
      Shared principles give humans and agents a consistent way to make decisions.
      This foundation puts them into code, instructions, and checks, so each change
      builds on the same standards.
    </p>
    <a class="self-start text-muted-foreground underline underline-offset-4 hover:text-foreground" href={site.notes} target="_blank" rel="noopener">
      Some personal notes on agentic coding ↗
    </a>
  </div>
  <div class="grid gap-px overflow-hidden border bg-border sm:grid-cols-2">
    {principles.map(({ title, icon, description }) => (
      <article class="flex flex-col gap-3 bg-background p-6">
        <h3 class="flex items-center gap-3 font-serif text-xl leading-snug">
          <svg aria-hidden="true" class="size-4 shrink-0 text-primary" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" viewBox="0 0 24 24">
            <Fragment set:html={icon} />
          </svg>
          {title}
        </h3>
        <p class="text-muted-foreground text-pretty">{description}</p>
      </article>
    ))}
  </div>
</Section>
