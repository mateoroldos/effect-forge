---
import "../styles/site.css";
import Flames from "../components/Flames.astro";
import { site } from "../site.ts";

type Props = { readonly title?: string };

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={site.description} />
    <title>{title ? `${title} · ${site.name}` : site.name}</title>
    <script is:inline>
      // The design system keys dark mode off a class, so it is set before paint.
      document.documentElement.classList.toggle("dark", matchMedia("(prefers-color-scheme: dark)").matches);
    </script>
  </head>
  <body class="flex min-h-screen flex-col text-sm/6">
    <div class="mx-auto flex w-full max-w-2xl flex-1 flex-col gap-20 px-6 pt-10 sm:pt-14">
      <header class="flex items-center justify-between font-mono text-sm text-muted-foreground">
        <span class="text-foreground">effect-forge</span>
        <a class="hover:text-foreground" href={site.repository} target="_blank" rel="noopener">github ↗</a>
      </header>
      <slot />
    </div>
    <footer class="mt-20">
      <div
        class="mx-auto flex max-w-2xl items-center justify-between border-t px-6 pt-6 font-mono text-xs text-muted-foreground"
      >
        <span>MIT</span>
        <a class="hover:text-foreground" href={site.repository} target="_blank" rel="noopener">GitHub ↗</a>
      </div>
      <Flames class="mt-12" />
    </footer>
  </body>
</html>
