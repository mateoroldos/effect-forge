---
import figlet from "figlet";
import FireFont from "figlet/importable-fonts/Fire Font-s.js";
import { site } from "../site.ts";

type Props = { readonly class?: string };

const { class: className } = Astro.props;

/* Fire Font draws with plain ASCII, so the site's mono face renders the grid exactly.
   Rows 1-4 of a glyph are the flame and rows 5-8 the letterform: drop the letterforms
   from a line of prose and fire is all that is left. */
figlet.parseFont("Fire Font-s", FireFont);
const fire = figlet
  .textSync(`${site.description} `.repeat(4), { font: "Fire Font-s" })
  .split("\n")
  .slice(1, 5)
  .join("\n");
---

<div
  aria-hidden="true"
  class:list={[
    "flex justify-center overflow-hidden pb-[0.35em] font-mono text-[clamp(6px,2.05vw,13px)]/none text-primary/40",
    "mask-x-from-58% mask-x-to-112%",
    className,
  ]}
>
  <pre>{fire}</pre>
</div>
